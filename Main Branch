<script>
// ── PARTICLES ──
const canvas = document.getElementById('particles-canvas');
const ctx = canvas.getContext('2d');
let particles = [];
function resize() { canvas.width = window.innerWidth; canvas.height = window.innerHeight; }
resize(); window.addEventListener('resize', resize);
class Particle {
  constructor() { this.reset(); }
  reset() {
    this.x = Math.random() * canvas.width;
    this.y = Math.random() * canvas.height;
    this.size = Math.random() * 2 + 0.5;
    this.vx = (Math.random() - 0.5) * 0.4;
    this.vy = (Math.random() - 0.5) * 0.4;
    this.alpha = Math.random() * 0.5 + 0.1;
    this.color = Math.random() > 0.5 ? '56,189,248' : '46,117,182';
  }
  update() {
    this.x += this.vx; this.y += this.vy;
    if (this.x < 0 || this.x > canvas.width || this.y < 0 || this.y > canvas.height) this.reset();
  }
  draw() {
    ctx.save();
    ctx.globalAlpha = this.alpha;
    ctx.fillStyle = `rgba(${this.color},1)`;
    ctx.beginPath();
    ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
    ctx.fill();
    ctx.restore();
  }
}
for (let i = 0; i < 80; i++) particles.push(new Particle());
function animParticles() {
  ctx.clearRect(0, 0, canvas.width, canvas.height);
  particles.forEach(p => { p.update(); p.draw(); });
  requestAnimationFrame(animParticles);
}
animParticles();

// ── SCROLL REVEAL ──
const observer = new IntersectionObserver(entries => {
  entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); } });
}, { threshold: 0.12 });
document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

// ── QUOTE CAROUSEL ──
const quotes = [
  "Revisit your feedback after every submission — not to dwell on mistakes, but to understand how to build something better next time.",
  "The best moment as a lecturer is when a student takes what you've taught and builds something that surpasses what you could have built yourself.",
  "Programming is a practical skill. Explain it, break it down, then demonstrate it — theory and practice always together.",
  "Being helpful doesn't stop when class ends. Availability and support are part of what makes a great mentor.",
  "Capable of adapting to any environment — that's the mindset every developer needs to survive and thrive."
];
let qi = 0;
const qEl = document.getElementById('quote-text');
const dotsEl = document.getElementById('quote-dots');
function renderDots() {
  dotsEl.innerHTML = '';
  quotes.forEach((_, i) => {
    const d = document.createElement('div');
    d.className = 'qdot' + (i === qi ? ' active' : '');
    d.onclick = () => goQuote(i);
    dotsEl.appendChild(d);
  });
}
function goQuote(idx) {
  qEl.classList.add('fade');
  setTimeout(() => { qi = idx; qEl.textContent = quotes[qi]; qEl.classList.remove('fade'); renderDots(); }, 500);
}
qEl.textContent = quotes[0]; renderDots();
setInterval(() => goQuote((qi + 1) % quotes.length), 5000);

// ── AI CHAT ──
const SYSTEM = `You are an AI assistant for Mr Ikraam Sadek's portfolio website. He is a Junior Lecturer at Belgium Campus in the Faculty of IT, Programming Department. Here is everything you know about him:

PROFESSIONAL DETAILS:
- Full name: Mr Ikraam Sadek
- Title: Junior Lecturer
- Department: Faculty of IT — Programming Department, Belgium Campus  
- Qualification: Advanced Diploma in Application Development, Rosebank College
- LinkedIn: https://www.linkedin.com/in/ik-sadek/
- Office: Upstairs Office, next to Beta
- Office hours: Monday–Thursday 08:00–17:00, Friday 08:00–16:00

MODULES TAUGHT:
- PRL161: Programming Preliminaries
- PRG171 & PRG181: Programming 1st Year (Semester 1 & 2)
- WPR271 & WPR281: Web Programming 2nd Year (Semester 1 & 2)

TEACHING PHILOSOPHY:
He makes classes engaging and interactive. He believes the best way to learn programming is through demonstration — explaining a concept (like a for loop), breaking it down step by step, then demonstrating it both theoretically and practically. He takes a mentoring role and is available via email after hours.

CAREER ADVICE:
Revisit your marks and feedback after submission — understand not just what went wrong, but how to improve and build something better next time.

PROFESSIONAL SUPERPOWER:
Genuine helpfulness — available and supportive to students beyond the lecture hall. Also excels at making programming tangible and practical.

FUN FACTS / HOBBIES (comfortable sharing publicly):
- Loves fishing — used to fish almost every weekend on the Eastern Cape coast
- Enjoys outdoor activities: hiking, quad biking, bungee jumping, roller coasters
- Used to visit the shooting range in Port Elizabeth
- Plays story-driven video games on weekends
- Originally from the Eastern Cape — joined Belgium Campus after responding to a recruitment email while job-searching after graduation

AVATAR/DESIGN VIBE: Playful, professional, technical. Likes blue, grey, and black — minimalist aesthetic.

INSPIRATION: Did not originally plan to be a lecturer. Found genuine enjoyment in teaching, particularly the moment when a student understands a concept and builds something that surpasses what they were taught.

Keep answers concise, friendly, and enthusiastic. Use emojis occasionally. If asked something you don't know, say you only have information about Mr Sadek's professional portfolio.`;

let chatHistory = [];

async function sendMessage() {
  const input = document.getElementById('chat-input');
  const btn = document.getElementById('chat-send');
  const msg = input.value.trim();
  if (!msg) return;

  appendMsg('user', msg);
  input.value = '';
  btn.disabled = true;

  chatHistory.push({ role: 'user', content: msg });

  const typingId = appendTyping();
  try {
    const res = await fetch('https://api.anthropic.com/v1/messages', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        model: 'claude-sonnet-4-20250514',
        max_tokens: 1000,
        system: SYSTEM,
        messages: chatHistory
      })
    });
    const data = await res.json();
    removeTyping(typingId);
    const reply = data.content?.map(b => b.text || '').join('') || "Sorry, I couldn't get a response.";
    chatHistory.push({ role: 'assistant', content: reply });
    appendMsg('ai', reply);
  } catch (e) {
    removeTyping(typingId);
    appendMsg('ai', 'Oops! Something went wrong connecting to the AI. Try again in a moment.');
  }
  btn.disabled = false;
}

function appendMsg(role, text) {
  const msgs = document.getElementById('chat-messages');
  const div = document.createElement('div');
  div.className = `msg ${role}`;
  div.innerHTML = `${role === 'ai' ? '<div class="msg-name">Portfolio AI</div>' : ''}
    <div class="msg-bubble">${text.replace(/\n/g, '<br>')}</div>`;
  msgs.appendChild(div);
  msgs.scrollTop = msgs.scrollHeight;
}

function appendTyping() {
  const msgs = document.getElementById('chat-messages');
  const id = 'typing-' + Date.now();
  const div = document.createElement('div');
  div.className = 'msg ai'; div.id = id;
  div.innerHTML = `<div class="msg-name">Portfolio AI</div>
    <div class="msg-bubble"><div class="typing-dots"><span></span><span></span><span></span></div></div>`;
  msgs.appendChild(div);
  msgs.scrollTop = msgs.scrollHeight;
  return id;
}
function removeTyping(id) { document.getElementById(id)?.remove(); }

function handleKey(e) { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendMessage(); } }
function askQuick(q) { document.getElementById('chat-input').value = q; sendMessage(); }
</script>
