<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Mr Ikraam Sadek — Lecturer Portfolio</title>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #0f172a;
    --bg2: #1E3A5F;
    --accent: #2E75B6;
    --accent2: #38bdf8;
    --text: #f8fafc;
    --muted: #94a3b8;
    --border: rgba(46,117,182,0.25);
    --card: rgba(30,58,95,0.4);
    --glow: rgba(56,189,248,0.15);
    --font: 'Space Grotesk', sans-serif;
    --mono: 'JetBrains Mono', monospace;
  }
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body {
    background: var(--bg);
    color: var(--text);
    font-family: var(--font);
    overflow-x: hidden;
    line-height: 1.6;
  }

  /* ── NAV ── */
  nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    display: flex; align-items: center; justify-content: space-between;
    padding: 1rem 2rem;
    background: rgba(15,23,42,0.85);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }
  .nav-logo { font-family: var(--mono); font-size: 1rem; color: var(--accent2); letter-spacing: 0.05em; }
  .nav-links { display: flex; gap: 2rem; list-style: none; }
  .nav-links a { color: var(--muted); text-decoration: none; font-size: 0.9rem; transition: color 0.2s; }
  .nav-links a:hover { color: var(--accent2); }

  /* ── HERO ── */
  #hero {
    min-height: 100vh;
    display: flex; align-items: center; justify-content: center;
    padding: 6rem 2rem 4rem;
    position: relative; overflow: hidden;
  }
  #particles-canvas {
    position: absolute; inset: 0; pointer-events: none;
  }
  .hero-inner {
    display: flex; align-items: center; gap: 5rem;
    max-width: 1100px; width: 100%; position: relative; z-index: 1;
    flex-wrap: wrap; justify-content: center;
  }
  .hero-text { flex: 1; min-width: 280px; }
  .hero-badge {
    display: inline-flex; align-items: center; gap: 0.5rem;
    background: rgba(46,117,182,0.15);
    border: 1px solid var(--border);
    padding: 0.35rem 1rem; border-radius: 99px;
    font-family: var(--mono); font-size: 0.78rem; color: var(--accent2);
    margin-bottom: 1.5rem;
    animation: fadeInDown 0.6s ease both;
  }
  .hero-badge::before { content: '●'; font-size: 0.5rem; animation: pulse-dot 2s infinite; }
  @keyframes pulse-dot { 0%,100%{opacity:1} 50%{opacity:0.3} }
  .hero-name {
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    font-weight: 700; line-height: 1.1;
    animation: fadeInDown 0.7s 0.1s ease both;
  }
  .hero-name span { color: var(--accent2); }
  .hero-title {
    font-family: var(--mono); color: var(--muted);
    font-size: 1rem; margin: 0.75rem 0;
    animation: fadeInDown 0.7s 0.2s ease both;
  }
  .hero-tagline {
    font-size: 1.1rem; color: var(--muted); font-style: italic;
    border-left: 3px solid var(--accent); padding-left: 1rem;
    margin: 1.5rem 0;
    animation: fadeInDown 0.7s 0.3s ease both;
  }
  .hero-cta {
    display: inline-flex; align-items: center; gap: 0.5rem;
    background: var(--accent); color: #fff;
    padding: 0.75rem 2rem; border-radius: 8px;
    text-decoration: none; font-weight: 600;
    transition: transform 0.2s, box-shadow 0.2s;
    animation: fadeInDown 0.7s 0.4s ease both;
  }
  .hero-cta:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(46,117,182,0.4); }

  /* CSS Avatar */
  .avatar-wrap {
    flex-shrink: 0;
    animation: fadeInDown 0.8s 0.2s ease both;
    position: relative;
  }
  .avatar-ring {
    width: 280px; height: 280px; border-radius: 50%;
    border: 2px solid var(--accent2);
    display: flex; align-items: center; justify-content: center;
    position: relative;
    animation: spin-ring 12s linear infinite;
    box-shadow: 0 0 60px rgba(56,189,248,0.1);
  }
  @keyframes spin-ring {
    0% { box-shadow: 0 0 60px rgba(56,189,248,0.1); }
    50% { box-shadow: 0 0 80px rgba(56,189,248,0.25); }
    100% { box-shadow: 0 0 60px rgba(56,189,248,0.1); }
  }
  .avatar-ring::before {
    content: ''; position: absolute; inset: -8px; border-radius: 50%;
    border: 1px dashed rgba(46,117,182,0.4);
    animation: spin-dash 20s linear infinite reverse;
  }
  @keyframes spin-dash { to { transform: rotate(360deg); } }
  .avatar-body {
    width: 230px; height: 230px; border-radius: 50%;
    background: linear-gradient(145deg, #1E3A5F, #0f172a);
    border: 2px solid rgba(46,117,182,0.5);
    position: relative; overflow: hidden;
    display: flex; flex-direction: column; align-items: center;
    justify-content: flex-end;
  }
  /* Head */
  .av-head {
    width: 80px; height: 85px; border-radius: 50% 50% 45% 45%;
    background: #d4956a;
    position: absolute; top: 45px; left: 50%; transform: translateX(-50%);
    z-index: 2;
  }
  /* Hair */
  .av-head::before {
    content: ''; position: absolute;
    width: 88px; height: 44px; border-radius: 50% 50% 0 0;
    background: #1a1a2e; top: -4px; left: -4px;
  }
  /* Eyes */
  .av-eyes {
    position: absolute; top: 35px; width: 100%;
    display: flex; justify-content: center; gap: 18px;
    z-index: 3;
  }
  .av-eye {
    width: 10px; height: 12px; border-radius: 50%;
    background: #1a1a2e;
    animation: blink 5s infinite;
  }
  @keyframes blink { 0%,96%,100%{scaleY(1)} 98%{transform:scaleY(0.1)} }
  /* Smile */
  .av-smile {
    position: absolute; top: 55px; left: 50%;
    transform: translateX(-50%);
    width: 30px; height: 14px;
    border-radius: 0 0 15px 15px;
    border-bottom: 3px solid #8b3a1a;
    z-index: 3;
  }
  /* Hoodie body */
  .av-hoodie {
    position: absolute; bottom: 0; left: 50%;
    transform: translateX(-50%);
    width: 160px; height: 130px;
    background: #1E3A5F;
    border-radius: 80px 80px 0 0;
    z-index: 1;
  }
  .av-hoodie::before {
    content: ''; position: absolute;
    top: 10px; left: 50%; transform: translateX(-50%);
    width: 40px; height: 60px; border-radius: 20px;
    background: rgba(0,0,0,0.3);
  }
  /* Laptop */
  .av-laptop {
    position: absolute; bottom: 8px; left: 50%;
    transform: translateX(-50%);
    width: 70px; height: 45px;
    background: #334155; border-radius: 5px 5px 0 0;
    z-index: 4;
  }
  .av-laptop::before {
    content: ''; position: absolute;
    bottom: -5px; left: -8px; right: -8px; height: 5px;
    background: #475569; border-radius: 0 0 3px 3px;
  }
  .av-screen {
    position: absolute; inset: 3px;
    background: var(--bg); border-radius: 3px;
    display: flex; align-items: center; justify-content: center;
    overflow: hidden;
  }
  .av-code-lines {
    width: 100%; padding: 4px;
  }
  .av-code-line {
    height: 3px; border-radius: 2px; margin: 2px 0;
    background: var(--accent2);
    animation: code-type 3s infinite;
  }
  .av-code-line:nth-child(1) { width: 70%; animation-delay: 0s; }
  .av-code-line:nth-child(2) { width: 50%; animation-delay: 0.4s; }
  .av-code-line:nth-child(3) { width: 85%; animation-delay: 0.8s; }
  .av-code-line:nth-child(4) { width: 40%; animation-delay: 1.2s; }
  @keyframes code-type { 0%{opacity:0.2} 50%{opacity:1} 100%{opacity:0.2} }

  /* ── SECTIONS ── */
  section { padding: 6rem 2rem; max-width: 1100px; margin: 0 auto; }
  .section-label {
    font-family: var(--mono); font-size: 0.8rem; color: var(--accent2);
    letter-spacing: 0.12em; text-transform: uppercase; margin-bottom: 0.5rem;
  }
  .section-title {
    font-size: clamp(1.8rem, 3vw, 2.5rem); font-weight: 700; margin-bottom: 3rem;
  }
  .section-title span { color: var(--accent2); }

  /* reveal animation */
  .reveal { opacity: 0; transform: translateY(30px); transition: opacity 0.6s ease, transform 0.6s ease; }
  .reveal.visible { opacity: 1; transform: none; }

  /* ── ABOUT ── */
  .about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: start; }
  @media(max-width:720px){ .about-grid { grid-template-columns: 1fr; } }
  .about-card {
    background: var(--card); border: 1px solid var(--border);
    border-radius: 16px; padding: 2rem;
    position: relative; overflow: hidden;
  }
  .about-card::before {
    content: ''; position: absolute;
    inset: 0; border-radius: 16px;
    background: linear-gradient(135deg, var(--glow), transparent);
    pointer-events: none;
    animation: glow-pulse 4s ease-in-out infinite;
  }
  @keyframes glow-pulse { 0%,100%{opacity:0.5} 50%{opacity:1} }
  .badge {
    display: inline-flex; align-items: center;
    background: rgba(46,117,182,0.2); border: 1px solid var(--border);
    color: var(--accent2); padding: 0.3rem 0.8rem; border-radius: 99px;
    font-size: 0.8rem; margin: 0.25rem;
  }
  .badges { margin-top: 1.5rem; }
  .info-row { display: flex; gap: 1rem; margin: 0.75rem 0; align-items: flex-start; }
  .info-row .icon { color: var(--accent2); font-size: 1.1rem; margin-top: 2px; flex-shrink: 0; }
  .info-row p { color: var(--muted); font-size: 0.9rem; }
  .info-row strong { color: var(--text); }

  /* ── MODULES ── */
  .modules-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem; }
  .module-card {
    background: var(--card); border: 1px solid var(--border);
    border-radius: 16px; padding: 1.75rem;
    transition: transform 0.3s, box-shadow 0.3s, border-color 0.3s;
    cursor: default;
    position: relative; overflow: hidden;
  }
  .module-card::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(135deg, rgba(46,117,182,0.1), transparent);
    opacity: 0; transition: opacity 0.3s;
  }
  .module-card:hover { transform: translateY(-6px) rotateX(2deg); box-shadow: 0 20px 40px rgba(0,0,0,0.4); border-color: var(--accent2); }
  .module-card:hover::after { opacity: 1; }
  .module-code { font-family: var(--mono); color: var(--accent2); font-size: 0.85rem; margin-bottom: 0.5rem; }
  .module-name { font-size: 1.1rem; font-weight: 600; margin-bottom: 0.5rem; }
  .module-desc { color: var(--muted); font-size: 0.9rem; }
  .module-year {
    display: inline-block; margin-top: 1rem;
    background: rgba(46,117,182,0.15); border: 1px solid var(--border);
    color: var(--accent2); padding: 0.2rem 0.6rem; border-radius: 6px; font-size: 0.78rem;
  }

  /* ── FUN FACTS ── */
  .facts-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.25rem; }
  .fact-card {
    background: var(--card); border: 1px solid var(--border);
    border-radius: 16px; padding: 1.5rem;
    cursor: pointer; text-align: center;
    transition: transform 0.3s, border-color 0.3s, background 0.3s;
    user-select: none;
  }
  .fact-card:hover, .fact-card.revealed {
    transform: scale(1.04);
    border-color: var(--accent2);
    background: rgba(30,58,95,0.7);
  }
  .fact-icon { font-size: 2.5rem; margin-bottom: 0.75rem; display: block; }
  .fact-hint { color: var(--muted); font-size: 0.85rem; margin-bottom: 0.5rem; }
  .fact-text { color: var(--text); font-size: 0.95rem; font-weight: 500; display: none; }
  .fact-card.revealed .fact-hint { display: none; }
  .fact-card.revealed .fact-text { display: block; }
  .fact-tap { color: var(--accent2); font-size: 0.75rem; margin-top: 0.5rem; font-family: var(--mono); }

  /* ── QUOTE WALL ── */
  .quote-wall {
    background: var(--card); border: 1px solid var(--border);
    border-radius: 20px; padding: 3rem;
    text-align: center; min-height: 200px;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    position: relative; overflow: hidden;
  }
  .quote-wall::before {
    content: '"'; position: absolute; top: -20px; left: 20px;
    font-size: 10rem; color: rgba(46,117,182,0.1);
    font-family: Georgia, serif; line-height: 1;
  }
  .quote-text {
    font-size: 1.3rem; font-style: italic; color: var(--text);
    max-width: 700px; line-height: 1.7;
    transition: opacity 0.5s, transform 0.5s;
    position: relative; z-index: 1;
  }
  .quote-text.fade { opacity: 0; transform: translateY(10px); }
  .quote-dots { display: flex; gap: 8px; margin-top: 2rem; justify-content: center; }
  .qdot {
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--border); transition: background 0.3s, transform 0.3s;
  }
  .qdot.active { background: var(--accent2); transform: scale(1.3); }

  /* ── CONTACT ── */
  .contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; }
  @media(max-width:600px){ .contact-grid { grid-template-columns: 1fr; } }
  .contact-card {
    background: var(--card); border: 1px solid var(--border);
    border-radius: 16px; padding: 2rem;
  }
  .contact-card h3 { margin-bottom: 1.5rem; color: var(--accent2); font-family: var(--mono); font-size: 0.9rem; letter-spacing: 0.1em; text-transform: uppercase; }
  .hours-row { display: flex; justify-content: space-between; padding: 0.6rem 0; border-bottom: 1px solid var(--border); font-size: 0.9rem; }
  .hours-row:last-child { border-bottom: none; }
  .hours-day { color: var(--muted); }
  .hours-time { color: var(--text); font-family: var(--mono); font-size: 0.85rem; }
  .cta-pulse {
    display: inline-flex; align-items: center; gap: 0.5rem;
    background: var(--accent); color: #fff;
    padding: 1rem 2rem; border-radius: 10px;
    text-decoration: none; font-weight: 600; font-size: 1.1rem;
    margin-top: 1.5rem;
    animation: pulse-cta 3s ease-in-out infinite;
    transition: transform 0.2s;
  }
  .cta-pulse:hover { transform: scale(1.04); animation-play-state: paused; }
  @keyframes pulse-cta {
    0%,100%{ box-shadow: 0 0 0 0 rgba(46,117,182,0.5); }
    50%{ box-shadow: 0 0 0 12px rgba(46,117,182,0); }
  }

  /* ── AI CHAT ── */
  #chat-section {
    background: linear-gradient(to bottom, var(--bg), #0a1628);
    padding: 6rem 2rem;
  }
  .chat-wrap { max-width: 800px; margin: 0 auto; }
  .chat-window {
    background: rgba(15,23,42,0.9); border: 1px solid var(--border);
    border-radius: 20px; overflow: hidden;
    box-shadow: 0 30px 80px rgba(0,0,0,0.5);
  }
  .chat-header {
    background: var(--card); padding: 1rem 1.5rem;
    display: flex; align-items: center; gap: 0.75rem;
    border-bottom: 1px solid var(--border);
  }
  .chat-dot { width: 10px; height: 10px; border-radius: 50%; }
  .chat-dot.red { background: #ff5f57; }
  .chat-dot.yellow { background: #ffbd2e; }
  .chat-dot.green { background: #28ca41; }
  .chat-title { margin-left: auto; font-family: var(--mono); font-size: 0.85rem; color: var(--muted); }
  .chat-ai-label { display: flex; align-items: center; gap: 0.5rem; }
  .ai-avatar { width: 28px; height: 28px; border-radius: 50%; background: var(--accent); display: flex; align-items: center; justify-content: center; font-size: 0.7rem; font-weight: 700; }
  .chat-messages { height: 380px; overflow-y: auto; padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem; scroll-behavior: smooth; }
  .chat-messages::-webkit-scrollbar { width: 4px; }
  .chat-messages::-webkit-scrollbar-track { background: transparent; }
  .chat-messages::-webkit-scrollbar-thumb { background: var(--border); border-radius: 2px; }
  .msg { max-width: 80%; }
  .msg.ai { align-self: flex-start; }
  .msg.user { align-self: flex-end; }
  .msg-bubble {
    padding: 0.75rem 1rem; border-radius: 16px; font-size: 0.9rem; line-height: 1.5;
  }
  .msg.ai .msg-bubble { background: var(--card); border: 1px solid var(--border); border-bottom-left-radius: 4px; color: var(--text); }
  .msg.user .msg-bubble { background: var(--accent); color: #fff; border-bottom-right-radius: 4px; }
  .msg-name { font-size: 0.75rem; color: var(--muted); margin-bottom: 0.25rem; font-family: var(--mono); }
  .typing-dots { display: flex; gap: 4px; padding: 0.5rem 0; }
  .typing-dots span { width: 7px; height: 7px; border-radius: 50%; background: var(--accent2); animation: bounce-dot 1.2s infinite; }
  .typing-dots span:nth-child(2) { animation-delay: 0.2s; }
  .typing-dots span:nth-child(3) { animation-delay: 0.4s; }
  @keyframes bounce-dot { 0%,80%,100%{transform:translateY(0)} 40%{transform:translateY(-8px)} }
  .chat-footer { padding: 1rem 1.5rem; border-top: 1px solid var(--border); display: flex; gap: 0.75rem; }
  .chat-input {
    flex: 1; background: rgba(30,58,95,0.3); border: 1px solid var(--border);
    border-radius: 10px; padding: 0.75rem 1rem; color: var(--text);
    font-family: var(--font); font-size: 0.9rem; outline: none; resize: none;
    transition: border-color 0.2s;
  }
  .chat-input:focus { border-color: var(--accent2); }
  .chat-input::placeholder { color: var(--muted); }
  .chat-send {
    background: var(--accent); color: #fff; border: none;
    padding: 0.75rem 1.25rem; border-radius: 10px;
    font-family: var(--font); font-weight: 600; font-size: 0.9rem;
    cursor: pointer; transition: transform 0.15s, background 0.2s;
    align-self: flex-end;
  }
  .chat-send:hover { background: var(--accent2); color: var(--bg); transform: scale(1.04); }
  .chat-send:disabled { opacity: 0.4; cursor: not-allowed; transform: none; }
  .quick-qs { display: flex; flex-wrap: wrap; gap: 0.5rem; padding: 0 1.5rem 1rem; }
  .quick-q {
    background: rgba(46,117,182,0.1); border: 1px solid var(--border);
    color: var(--accent2); padding: 0.35rem 0.85rem; border-radius: 99px;
    font-size: 0.8rem; cursor: pointer; transition: background 0.2s, border-color 0.2s;
    font-family: var(--font);
  }
  .quick-q:hover { background: rgba(46,117,182,0.25); border-color: var(--accent2); }

  /* ── FOOTER ── */
  footer {
    text-align: center; padding: 3rem 2rem;
    border-top: 1px solid var(--border);
    color: var(--muted); font-size: 0.85rem;
    font-family: var(--mono);
  }
  footer a { color: var(--accent2); text-decoration: none; }

  /* ── ANIMATIONS ── */
  @keyframes fadeInDown { from{opacity:0;transform:translateY(-20px)} to{opacity:1;transform:none} }

  /* ── MOBILE ── */
  @media(max-width:700px){
    nav { padding: 0.75rem 1rem; }
    .nav-links { gap: 1rem; }
    .hero-inner { gap: 3rem; }
    .avatar-ring { width: 220px; height: 220px; }
    .avatar-body { width: 180px; height: 180px; }
    section { padding: 4rem 1.25rem; }
    .about-grid { gap: 1.5rem; }
    .chat-messages { height: 300px; }
  }
</style>
</head>
<body>

<!-- NAV -->
<nav>
  <span class="nav-logo">IK.dev</span>
  <ul class="nav-links">
    <li><a href="#about">About</a></li>
    <li><a href="#modules">Modules</a></li>
    <li><a href="#facts">Facts</a></li>
    <li><a href="#chat-section">Ask AI</a></li>
    <li><a href="#contact">Contact</a></li>
  </ul>
</nav>

<!-- HERO -->
<section id="hero">
  <canvas id="particles-canvas"></canvas>
  <div class="hero-inner">
    <div class="hero-text">
      <div class="hero-badge">Junior Lecturer — Belgium Campus</div>
      <h1 class="hero-name">Mr Ikraam<br><span>Sadek</span></h1>
      <p class="hero-title">// Faculty of IT · Programming Department</p>
      <p class="hero-tagline">"Capable of adapting to any environment"</p>
      <a class="hero-cta" href="https://www.linkedin.com/in/ik-sadek/" target="_blank">
        Connect on LinkedIn →
      </a>
    </div>
    <div class="avatar-wrap">
      <div class="avatar-ring">
        <div class="avatar-body">
          <div class="av-head">
            <div class="av-eyes">
              <div class="av-eye"></div>
              <div class="av-eye"></div>
            </div>
            <div class="av-smile"></div>
          </div>
          <div class="av-hoodie"></div>
          <div class="av-laptop">
            <div class="av-screen">
              <div class="av-code-lines">
                <div class="av-code-line"></div>
                <div class="av-code-line"></div>
                <div class="av-code-line"></div>
                <div class="av-code-line"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ABOUT -->
<section id="about">
  <div class="reveal">
    <p class="section-label">// 01 — about</p>
    <h2 class="section-title">The <span>Person</span> Behind the Code</h2>
  </div>
  <div class="about-grid">
    <div class="about-card reveal">
