<div id="career-chat-widget" class="chat-widget-closed">
    <button id="chat-toggle-btn" aria-label="Open Career Chat">
        <span class="chat-icon">💬</span>
        <span class="chat-btn-text">Talk Career Strategy!</span>
    </button>

    <div id="chat-window">
        <div class="chat-header">
            <div class="chat-header-avatar">🤖</div>
            <div class="chat-header-info">
                <h4>Career Bot Co-Pilot</h4>
                <p class="chat-status"><span class="status-dot"></span> Online & Operational</p>
            </div>
            <button id="chat-close-btn" aria-label="Close Chat">&times;</button>
        </div>

        <div id="chat-messages-box">
            <div class="message bot-message">
                <p>Hi there! 👋 I am your Lecturer's AI Career Co-Pilot. Ask me about our IT modules, career paths, or my ultimate tech superpower! What is on your mind?</p>
            </div>
        </div>

        <form id="chat-input-form">
            <input type="text" id="chat-user-input" placeholder="Type 'modules', 'superpower', 'advice'..." autocomplete="off" required>
            <button type="submit" id="chat-send-btn" aria-label="Send Message">
                <svg viewBox="0 0 24 24" width="18" height="18"><path fill="currentColor" d="M2,21L23,12L2,3V10L17,12L2,14V21Z"/></svg>
            </button>
        </form>
    </div>
</div>
