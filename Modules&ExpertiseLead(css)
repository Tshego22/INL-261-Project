/* ── MODULES ── */
.modules-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem; }

/* Legend */
.modules-legend { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 2rem; }
.legend-item { display: flex; align-items: center; gap: 7px; font-size: 0.8rem; color: var(--muted); }
.legend-dot { width: 10px; height: 10px; border-radius: 50%; }
.dot-foundation { background: #fbbf24; }
.dot-first      { background: #60a5fa; }
.dot-second     { background: #a78bfa; }

/* Flip card structure */
.module-card {
  perspective: 1000px;
  background: none;
  border: none;
  padding: 0;
  cursor: pointer;
  position: relative;
  overflow: visible;
}
.card-inner {
  position: relative;
  width: 100%;
  min-height: 220px;
  transform-style: preserve-3d;
  transition: transform 0.45s ease;
  border-radius: 16px;
}
.module-card.flipped .card-inner { transform: rotateY(180deg); }

.card-front, .card-back {
  position: absolute;
  inset: 0;
  border-radius: 16px;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  padding: 1.75rem;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  background: var(--card);
  border: 1px solid var(--border);
  transition: border-color 0.3s, box-shadow 0.3s;
}
.card-front::after {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 16px;
  background: linear-gradient(135deg, rgba(46,117,182,0.1), transparent);
  opacity: 0;
  transition: opacity 0.3s;
  pointer-events: none;
}
.module-card:hover .card-front::after { opacity: 1; }
.module-card:hover .card-front { box-shadow: 0 20px 40px rgba(0,0,0,0.4); }

.card-back {
  transform: rotateY(180deg);
  justify-content: center;
  align-items: center;
  text-align: center;
  gap: 0.75rem;
}

/* Accent stripes by year level */
.module-card.foundation .card-front,
.module-card.foundation .card-back  { border-left: 3px solid #fbbf24; }
.module-card.first-year .card-front,
.module-card.first-year .card-back  { border-left: 3px solid #60a5fa; }
.module-card.second-year .card-front,
.module-card.second-year .card-back { border-left: 3px solid #a78bfa; }

/* Front content */
.module-code { font-family: var(--mono); color: var(--accent2); font-size: 0.85rem; margin-bottom: 0.25rem; }
.module-name { font-size: 1.1rem; font-weight: 600; margin-bottom: 0.25rem; }
.module-desc { color: var(--muted); font-size: 0.9rem; flex: 1; }
.flip-hint   { font-size: 0.68rem; color: var(--muted); opacity: 0.4; margin-top: auto; letter-spacing: 0.06em; }

/* Back content */
.back-icon  { font-size: 2rem; }
.back-label { font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); font-family: var(--mono); }
.back-name  { font-size: 1rem; font-weight: 700; color: var(--text); line-height: 1.4; }
.back-code  { font-size: 0.78rem; font-weight: 600; letter-spacing: 0.12em; color: var(--muted); font-family: var(--mono); text-transform: uppercase; }

/* Year badges */
.module-year {
  display: inline-block;
  margin-top: 0.5rem;
  padding: 0.2rem 0.7rem;
  border-radius: 6px;
  font-size: 0.78rem;
  align-self: flex-start;
}
.badge-foundation { background: rgba(251,191,36,0.12); color: #fbbf24; border: 1px solid rgba(251,191,36,0.28); }
.badge-first      { background: rgba(96,165,250,0.12);  color: #60a5fa; border: 1px solid rgba(96,165,250,0.28); }
.badge-second     { background: rgba(167,139,250,0.12); color: #a78bfa; border: 1px solid rgba(167,139,250,0.28); }
