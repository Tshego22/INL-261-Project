    .chip-1 { top: 8%;  right: -2%; animation: chipFloat1 7s ease-in-out infinite; }
    .chip-2 { top: 42%; left: -8%; animation: chipFloat2 8s ease-in-out infinite; }
    .chip-3 { bottom: 10%; right: 0%; animation: chipFloat1 9s ease-in-out 1s infinite; color: #86efac; }
    .chip-4 { bottom: 30%; left: -2%; animation: chipFloat2 6s ease-in-out 0.5s infinite; color: #7dd3fc; }


    .scroll-indicator {
      position: absolute;
      bottom: clamp(1.5rem, 3vh, 2.5rem);
      left: 50%;
      transform: translateX(-50%);
      z-index: 5;
      display: flex;
      flex-direction: column;
