    .lc:nth-child(4) { width: 42%; background: #86efac;            animation-delay: 1.05s; }
    .lc:nth-child(5) { width: 65%; background: #7dd3fc;            animation-delay: 1.4s; }
    .lc:nth-child(6) { width: 80%; background: var(--col-cyan);   animation-delay: 1.75s; }

    .laptop-base {
      width: 108%;
      height: 5px;
      margin-left: -4%;
      background: linear-gradient(90deg, #0a1a30, #1e3a5f, #0a1a30);
      border: 1px solid rgba(56,190,252,0.35);
