<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Mr. Ikraam Sadek | Lecturer Portfolio</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Exo+2:wght@300;400;600;700;900&family=Share+Tech+Mono&family=Rajdhani:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <style>
    

    :root {
      --col-bg:          #070d1a;
      --col-surface:     #0c1628;
      --col-panel:       rgba(13, 27, 55, 0.65);
      --col-border:      rgba(56, 190, 252, 0.15);
      --col-border-hi:   rgba(56, 190, 252, 0.45);
      --col-cyan:        #38befc;
      --col-cyan-mid:    #1e8fc4;
      --col-cyan-dim:    rgba(56, 190, 252, 0.25);
      --col-cyan-glow:   rgba(56, 190, 252, 0.55);
      --col-ice:         #a8e6ff;
      --col-white:       #f0f8ff;
      --col-muted:       #8baabe;
      --col-ghost:       #3d566e;

      --font-hero:   'Exo 2', sans-serif;
      --font-mono:   'Share Tech Mono', monospace;
      --font-ui:     'Rajdhani', sans-serif;

      --ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);
      --ease-in-out:   cubic-bezier(0.4, 0, 0.2, 1);
    }

  
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    html {
      scroll-behavior: smooth;
      height: 100%;
    }

    body {
      min-height: 100vh;
      background: var(--col-bg);
      color: var(--col-white);
      font-family: var(--font-hero);
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
      cursor: none; /* custom cursor */
    }

    
    .cursor-dot {
      position: fixed;
      width: 8px; height: 8px;
      background: var(--col-cyan);
      border-radius: 50%;
      pointer-events: none;
      z-index: 9999;
      transform: translate(-50%, -50%);
      transition: transform 0.05s;
      box-shadow: 0 0 10px var(--col-cyan), 0 0 20px var(--col-cyan);
    }

    .cursor-ring {
      position: fixed;
      width: 36px; height: 36px;
      border: 1px solid rgba(56, 190, 252, 0.55);
      border-radius: 50%;
      pointer-events: none;
      z-index: 9998;
      transform: translate(-50%, -50%);
      transition: all 0.12s var(--ease-out-expo);
    }

   
    #canvas {
      position: fixed;
      inset: 0;
      z-index: 0;
      pointer-events: none;
    }

    
    .scanlines {
      position: fixed;
      inset: 0;
      z-index: 1;
      pointer-events: none;
      background: repeating-linear-gradient(
        to bottom,
        transparent 0px,
        transparent 3px,
        rgba(0,0,0,0.03) 3px,
        rgba(0,0,0,0.03) 4px
      );
    }

   
    .bg-deco {
      position: fixed;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      overflow: hidden;
    }

   
    .blob {
      position: absolute;
      border-radius: 50%;
      filter: blur(100px);
      opacity: 0.07;
      animation: blobDrift 20s ease-in-out infinite alternate;
    }

    .blob-1 {
      width: 600px; height: 600px;
      background: var(--col-cyan);
      top: -200px; right: -100px;
      animation-delay: 0s;
    }

    .blob-2 {
      width: 400px; height: 400px;
      background: #1e6fa8;
      bottom: -100px; left: -80px;
      animation-delay: -8s;
    }

    
    .h-line {
      position: absolute;
      height: 1px;
      background: linear-gradient(90deg, transparent, var(--col-border), transparent);
      left: 0; right: 0;
      animation: lineFlicker 6s ease-in-out infinite;
    }
    .h-line:nth-child(3) { top: 30%; animation-delay: 0s; }
    .h-line:nth-child(4) { top: 65%; animation-delay: 2s; }
    .h-line:nth-child(5) { top: 80%; animation-delay: 4s; }

   
    .v-line {
      position: absolute;
      width: 1px;
      background: linear-gradient(180deg, transparent, var(--col-border), transparent);
      top: 0; bottom: 0;
      animation: lineFlicker 8s ease-in-out infinite;
    }
    .v-line:nth-child(6) { left: 15%;  animation-delay: 1s; }
    .v-line:nth-child(7) { right: 15%; animation-delay: 3s; }

    
    .navbar {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 100;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: clamp(0.9rem, 2vw, 1.4rem) clamp(1.5rem, 5vw, 5rem);
      background: rgba(7, 13, 26, 0.7);
      backdrop-filter: blur(20px) saturate(180%);
      border-bottom: 1px solid var(--col-border);
      animation: slideDown 0.7s var(--ease-out-expo) both;
    }

    .nav-brand {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      text-decoration: none;
    }

    .nav-brand-icon {
      width: 34px; height: 34px;
      border: 1px solid var(--col-border-hi);
      border-radius: 8px;
      background: var(--col-panel);
      display: flex; align-items: center; justify-content: center;
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: var(--col-cyan);
    }

    .nav-brand-text {
      font-family: var(--font-ui);
      font-size: clamp(0.9rem, 1.8vw, 1.1rem);
      font-weight: 700;
      letter-spacing: 0.08em;
      color: var(--col-white);
      text-transform: uppercase;
    }

    .nav-brand-text span { color: var(--col-cyan); }

    .nav-menu {
      display: flex;
      gap: clamp(1.2rem, 2.5vw, 2.5rem);
      list-style: none;
    }

    .nav-menu a {
      font-family: var(--font-mono);
      font-size: clamp(0.65rem, 1.1vw, 0.76rem);
      color: var(--col-muted);
      text-decoration: none;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      position: relative;
      transition: color 0.25s;
    }

    .nav-menu a::before {
      content: attr(data-num);
      margin-right: 4px;
      color: var(--col-cyan);
      opacity: 0.6;
      font-size: 0.6em;
    }

    .nav-menu a::after {
      content: '';
      position: absolute;
      bottom: -3px; left: 0;
      width: 0; height: 1px;
      background: var(--col-cyan);
      box-shadow: 0 0 6px var(--col-cyan);
      transition: width 0.3s var(--ease-out-expo);
    }

    .nav-menu a:hover { color: var(--col-cyan); }
    .nav-menu a:hover::after { width: 100%; }

    .nav-status {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.35rem 0.9rem;
      border: 1px solid var(--col-border);
      border-radius: 100px;
      background: var(--col-panel);
      backdrop-filter: blur(10px);
    }

    .status-dot {
      width: 6px; height: 6px;
      border-radius: 50%;
      background: #4ade80;
      box-shadow: 0 0 8px #4ade80;
      animation: statusPulse 2.5s ease-in-out infinite;
    }

    .status-text {
      font-family: var(--font-mono);
      font-size: 0.62rem;
      color: #4ade80;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

   
    .hero {
      position: relative;
      z-index: 2;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: clamp(6rem, 10vh, 9rem) clamp(1.5rem, 6vw, 6rem) clamp(2rem, 4vh, 4rem);
    }

    .hero-grid {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: clamp(2rem, 5vw, 6rem);
      width: 100%;
      max-width: 1380px;
    }

    .hero-text {
      flex: 1 1 0;
      min-width: 0;
      display: flex;
      flex-direction: column;
      gap: clamp(1rem, 2.2vw, 1.6rem);
    }


    .hero-tag {
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      width: fit-content;
      padding: 0.3rem 0.85rem 0.3rem 0.5rem;
      border: 1px solid var(--col-border-hi);
      border-radius: 100px;
      background: rgba(56, 190, 252, 0.06);
      backdrop-filter: blur(8px);
      opacity: 0;
      animation: revealUp 0.6s var(--ease-out-expo) 0.1s forwards;
    }

    .tag-icon {
      width: 22px; height: 22px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--col-cyan), var(--col-cyan-mid));
      display: flex; align-items: center; justify-content: center;
      font-size: 0.6rem;
      flex-shrink: 0;
    }

    .tag-text {
      font-family: var(--font-mono);
      font-size: clamp(0.6rem, 1.1vw, 0.7rem);
      color: var(--col-cyan);
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

   
    .hero-pre {
      font-family: var(--font-mono);
      font-size: clamp(0.75rem, 1.5vw, 0.9rem);
      color: var(--col-muted);
      letter-spacing: 0.2em;
      text-transform: uppercase;
      opacity: 0;
      animation: revealUp 0.6s var(--ease-out-expo) 0.2s forwards;
    }

    .hero-pre .accent { color: var(--col-cyan); }

    
    .hero-name {
      font-family: var(--font-hero);
      font-size: clamp(3rem, 7.5vw, 6.5rem);
      font-weight: 900;
      line-height: 0.95;
      letter-spacing: -0.02em;
      opacity: 0;
      animation: revealUp 0.7s var(--ease-out-expo) 0.3s forwards;
    }

    .name-first {
      display: block;
      color: var(--col-white);
    }

    .name-last {
      display: block;
      color: transparent;
      -webkit-text-stroke: 2px var(--col-cyan);
      position: relative;
      filter: drop-shadow(0 0 22px rgba(56,190,252,0.7));
      animation: nameGlow 3s ease-in-out infinite;
    }

   
    .hero-divider {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      opacity: 0;
      animation: revealUp 0.6s var(--ease-out-expo) 0.42s forwards;
    }

    .divider-line {
      flex: 1;
      max-width: 60px;
      height: 1px;
      background: linear-gradient(90deg, var(--col-cyan), transparent);
    }

    .divider-label {
      font-family: var(--font-mono);
      font-size: clamp(0.6rem, 1vw, 0.68rem);
      color: var(--col-ghost);
      letter-spacing: 0.18em;
      text-transform: uppercase;
    }

   
    .hero-dept {
      opacity: 0;
      animation: revealUp 0.6s var(--ease-out-expo) 0.5s forwards;
    }

    .dept-title {
      font-family: var(--font-ui);
      font-size: clamp(1rem, 2vw, 1.35rem);
      font-weight: 600;
      color: var(--col-ice);
      letter-spacing: 0.05em;
    }

    .dept-sub {
      font-family: var(--font-mono);
      font-size: clamp(0.65rem, 1.2vw, 0.78rem);
      color: var(--col-muted);
      margin-top: 0.25rem;
      letter-spacing: 0.1em;
    }

   
    .hero-tagline {
      font-size: clamp(0.9rem, 1.8vw, 1.1rem);
      font-weight: 300;
      color: var(--col-muted);
      line-height: 1.7;
      max-width: 480px;
      opacity: 0;
      animation: revealUp 0.6s var(--ease-out-expo) 0.58s forwards;
    }

    .hero-tagline strong {
      color: var(--col-white);
      font-weight: 600;
    }

    .hero-tagline em {
      font-style: normal;
      color: var(--col-cyan);
    }

   
    .terminal {
      background: rgba(7, 13, 26, 0.8);
      border: 1px solid var(--col-border);
      border-left: 2px solid var(--col-cyan);
      border-radius: 0 8px 8px 0;
      padding: 0.8rem 1.1rem;
      width: fit-content;
      opacity: 0;
      animation: revealUp 0.6s var(--ease-out-expo) 0.66s forwards;
      backdrop-filter: blur(10px);
    }

    .terminal-bar {
      display: flex;
      gap: 5px;
      margin-bottom: 0.5rem;
    }

    .t-dot {
      width: 7px; height: 7px;
      border-radius: 50%;
    }

    .t-dot:nth-child(1) { background: #ff5f57; }
    .t-dot:nth-child(2) { background: #febe2e; }
    .t-dot:nth-child(3) { background: #28c840; }

    .terminal-line {
      font-family: var(--font-mono);
      font-size: clamp(0.65rem, 1.2vw, 0.78rem);
      line-height: 1.7;
      color: var(--col-ghost);
    }

    .t-prompt  { color: var(--col-cyan); }
    .t-cmd     { color: var(--col-white); }
    .t-key     { color: #7dd3fc; }
    .t-val     { color: var(--col-cyan); }
    .t-str     { color: #86efac; }
    .t-comment { color: var(--col-ghost); opacity: 0.7; }

   
    .hero-ctas {
      display: flex;
      flex-wrap: wrap;
      gap: 0.85rem;
      opacity: 0;
      animation: revealUp 0.6s var(--ease-out-expo) 0.74s forwards;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      padding: 0.8rem 1.8rem;
      font-family: var(--font-ui);
      font-size: clamp(0.75rem, 1.4vw, 0.9rem);
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      text-decoration: none;
      border-radius: 6px;
      cursor: pointer;
      border: none;
      transition: all 0.3s var(--ease-out-expo);
      position: relative;
      overflow: hidden;
    }

    .btn::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, rgba(255,255,255,0.12) 0%, transparent 60%);
      opacity: 0;
      transition: opacity 0.3s;
    }

    .btn:hover::before { opacity: 1; }

   
    .btn-primary {
      background: linear-gradient(135deg, var(--col-cyan) 0%, var(--col-cyan-mid) 100%);
      color: var(--col-bg);
      box-shadow:
        0 0 25px rgba(56,190,252,0.3),
        0 4px 20px rgba(56,190,252,0.2),
        inset 0 1px 0 rgba(255,255,255,0.2);
    }

    .btn-primary:hover {
      transform: translateY(-3px) scale(1.03);
      box-shadow:
        0 0 40px rgba(56,190,252,0.55),
        0 8px 30px rgba(56,190,252,0.35);
    }

    
    .btn-secondary {
      background: var(--col-panel);
      color: var(--col-cyan);
      border: 1px solid var(--col-border-hi);
      backdrop-filter: blur(10px);
      box-shadow: 0 0 12px rgba(56,190,252,0.05);
    }

    .btn-secondary:hover {
      background: rgba(56,190,252,0.1);
      border-color: var(--col-cyan);
      transform: translateY(-3px);
      box-shadow: 0 0 24px rgba(56,190,252,0.2);
    }

    .btn-icon {
      width: 16px; height: 16px;
      flex-shrink: 0;
    }

    
    .btn-primary .btn-pulse {
      position: absolute;
      inset: -1px;
      border-radius: 6px;
      border: 1px solid var(--col-cyan);
      animation: btnPulseRing 2.5s ease-out infinite;
    }

   
    .hero-metrics {
      display: flex;
      gap: clamp(1.2rem, 2.5vw, 2.2rem);
      padding-top: 0.3rem;
      opacity: 0;
      animation: revealUp 0.6s var(--ease-out-expo) 0.82s forwards;
    }

    .metric {
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
    }

    .metric-val {
      font-family: var(--font-hero);
      font-size: clamp(1.6rem, 3.2vw, 2.4rem);
      font-weight: 700;
      color: var(--col-cyan);
      line-height: 1;
      text-shadow: 0 0 18px rgba(56,190,252,0.55);
    }

    .metric-label {
      font-family: var(--font-mono);
      font-size: clamp(0.55rem, 1vw, 0.65rem);
      color: var(--col-ghost);
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    .metric-sep {
      width: 1px;
      background: var(--col-border);
      align-self: stretch;
      margin: 0 0.3rem;
    }

    
    .hero-visual {
      flex: 0 0 auto;
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      animation: revealScale 0.9s var(--ease-out-expo) 0.35s forwards;
    }

    
    .avatar-scene {
      position: relative;
      width: clamp(280px, 36vw, 460px);
      height: clamp(280px, 36vw, 460px);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    
    .ring {
      position: absolute;
      border-radius: 50%;
      inset: 0;
    }

    .ring-a {
      border: 1px solid rgba(56,190,252,0.15);
      animation: spinRing 22s linear infinite;
    }

    .ring-a::before,
    .ring-a::after {
      content: '';
      position: absolute;
      width: 10px; height: 10px;
      border-radius: 50%;
      background: var(--col-cyan);
      box-shadow: 0 0 14px var(--col-cyan), 0 0 28px var(--col-cyan);
    }

    .ring-a::before { top: -5px; left: calc(50% - 5px); }
    .ring-a::after  { bottom: -5px; right: calc(50% - 5px); }

    .ring-b {
      inset: 20px;
      border: 1px dashed rgba(56,190,252,0.08);
      animation: spinRing 30s linear infinite reverse;
    }

    .ring-c {
      inset: 36px;
      border: 1px solid rgba(56,190,252,0.12);
      animation: spinRing 16s linear infinite;
    }

    .ring-c::before {
      content: '';
      position: absolute;
      right: -4px; top: 38%;
      width: 7px; height: 7px;
      border-radius: 50%;
      background: #7dd3fc;
      box-shadow: 0 0 10px #7dd3fc;
    }

    
    .ring-ticks {
      position: absolute;
      inset: 0;
      border-radius: 50%;
      animation: spinRing 22s linear infinite;
    }

    .tick {
      position: absolute;
      width: 2px;
      height: 8px;
      background: rgba(56,190,252,0.35);
      left: calc(50% - 1px);
      top: 0;
      transform-origin: 1px clamp(140px, 18vw, 230px);
      border-radius: 1px;
    }

    
    .avatar-card {
      position: relative;
      z-index: 5;
      width: clamp(195px, 26vw, 310px);
      height: clamp(195px, 26vw, 310px);
      background: linear-gradient(145deg, rgba(13,30,60,0.9) 0%, rgba(7,13,26,0.95) 100%);
      border: 1px solid var(--col-border-hi);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      backdrop-filter: blur(20px);
      box-shadow:
        0 0 50px rgba(56,190,252,0.12),
        0 0 100px rgba(56,190,252,0.06),
        inset 0 1px 0 rgba(255,255,255,0.06),
        inset 0 -1px 0 rgba(56,190,252,0.1);
      animation: floatCard 5.5s ease-in-out infinite;
    }

  
    .avatar-pool {
      position: absolute;
      z-index: 3;
      bottom: 10%;
      left: 50%;
      transform: translateX(-50%);
      width: 50%;
      height: 30px;
      background: var(--col-cyan);
      filter: blur(30px);
      opacity: 0.18;
      border-radius: 50%;
      animation: floatCard 5.5s ease-in-out infinite;
    }

    .char {
      position: relative;
      width: clamp(115px, 15vw, 185px);
      height: clamp(125px, 16vw, 200px);
      display: flex;
      flex-direction: column;
      align-items: center;
    }

   
    .char-head {
      position: relative;
      width: 46%;
      padding-bottom: 46%; /* square => circle */
      background: linear-gradient(155deg, #f9d9b8 0%, #e8b88a 100%);
      border-radius: 50% 50% 45% 45% / 55% 55% 45% 45%;
      z-index: 4;
      box-shadow: 0 3px 12px rgba(0,0,0,0.4);
      flex-shrink: 0;
    }

    
    .char-head::before {
      content: '';
      position: absolute;
      top: -18%;
      left: 5%;
      right: 5%;
      height: 55%;
      background: #1a1008;
      border-radius: 50% 50% 0 0;
      z-index: 1;
    }

   
    .char-eye {
      position: absolute;
      top: 40%;
      width: 13%;
      aspect-ratio: 1;
      background: #1e293b;
      border-radius: 50%;
      z-index: 5;
      animation: charBlink 4s ease-in-out infinite;
    }
    .char-eye.l { left: 22%; }
    .char-eye.r { right: 22%; }

    .char-eye::after {
      content: '';
      position: absolute;
      top: 15%; right: 15%;
      width: 32%; height: 32%;
      background: #fff;
      border-radius: 50%;
      opacity: 0.8;
    }

   
    .char-mouth {
      position: absolute;
      top: 62%;
      left: 50%;
      transform: translateX(-50%);
      width: 28%;
      height: 10%;
      border-bottom: 2px solid rgba(180,100,60,0.6);
      border-radius: 0 0 50% 50%;
      z-index: 5;
    }

   
    .char-body {
      position: relative;
      width: 82%;
      flex: 1;
      background: linear-gradient(155deg, #0c2040 0%, #071228 100%);
      border-radius: 14px 14px 8px 8px;
      margin-top: -4%;
      z-index: 3;
      box-shadow: 0 6px 22px rgba(0,0,0,0.5);
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }

   
    .char-body::before {
      content: '';
      position: absolute;
      bottom: 18%;
      left: 50%;
      transform: translateX(-50%);
      width: 50%;
      height: 22%;
      border: 1px solid rgba(56,190,252,0.2);
      border-radius: 30px;
      background: rgba(56,190,252,0.04);
    }

    
    .char-body::after {
      content: '';
      position: absolute;
      top: 12%;
      left: 50%;
