      color: var(--col-muted);
      white-space: nowrap;
      backdrop-filter: blur(10px);
      z-index: 10;
      box-shadow: 0 4px 14px rgba(0,0,0,0.3);
      display: flex;
      align-items: center;
      gap: 0.3rem;
    }

    .chip-dot {
      width: 5px; height: 5px;
      border-radius: 50%;
      background: var(--col-cyan);
      box-shadow: 0 0 6px var(--col-cyan);
      flex-shrink: 0;
